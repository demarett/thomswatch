{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "overwatch-tracker": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [{"glob": "**/*", "input": "public"}],
            "styles": ["src/styles.scss"]
          },
          "configurations": {
            "development": {},
            "production": {
              "outputHashing": "all",
              "budgets": [{"type": "initial", "maximumWarning": "1MB", "maximumError": "2MB"}]
            }
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {"buildTarget": "overwatch-tracker:build:production"},
            "development": {"buildTarget": "overwatch-tracker:build"}
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {"runner": "vitest", "tsConfig": "tsconfig.spec.json", "watch": false}
        }
      }
    }
  },
  "cli": {"analytics": false}
}
